# =============================================================================
# Les Tirages de Marie — environment variables
# Copy to .env and fill in real values. Never commit .env.
#
# NOTE: this file is named `env.example` (no leading dot) because the local
# Claude Code safety hook blocks writes to any path matching `\.env(\.|$)`.
# Rename to `.env.example` after cloning:
#   mv env.example .env.example
# =============================================================================

# -----------------------------------------------------------------------------
# CORE (required for the server to start sensibly)
# -----------------------------------------------------------------------------

# MySQL / TiDB connection string used by Drizzle ORM + mysql2.
# Local Docker: docker run -d --name marie-db -p 3306:3306 \
#   -e MYSQL_ROOT_PASSWORD=marie -e MYSQL_DATABASE=tirages mysql:8
DATABASE_URL=mysql://root:marie@localhost:3306/tirages

# 32+ byte random secret used to sign session JWTs (HS256 via jose).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# dev | production
NODE_ENV=development

# HTTP port (optional, defaults to 3000; auto-increments if busy).
PORT=3000

# Public base URL of the app. Used for Stripe success/cancel URLs and email links.
# Dev: http://localhost:3000 (or the ngrok URL when sharing).
# Prod: https://tiragesdemarie.fr
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# STRIPE — required once checkout is live (Phase 2A)
# -----------------------------------------------------------------------------

# Secret key (sk_test_... in dev, sk_live_... in prod).
STRIPE_SECRET_KEY=

# Publishable key. Exposed to the client (VITE_ prefix = shipped to browser).
VITE_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Obtain with:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Required: without it, payments stay "pending" in DB forever.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# EMAIL (Resend) — required for transactional emails (Phase 2B)
# -----------------------------------------------------------------------------

# Resend API key — https://resend.com (free tier: 100 emails/day).
# If empty, the server logs instead of sending (see server/_core/email.ts).
RESEND_API_KEY=

# Verified sender — must belong to a domain validated in the Resend dashboard.
FROM_EMAIL=hello@tiragesdemarie.fr

# Where admin notifications (new booklet request, new booking, payment success) are sent.
OWNER_EMAIL=marie@example.com

# -----------------------------------------------------------------------------
# S3 — required once booklet PDF delivery lands (Phase 3)
# -----------------------------------------------------------------------------

S3_BUCKET=
S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# AUTH — Manus OAuth is dead outside Manus. Clerk/Better Auth migration pending.
# Leave these empty. Admin routes return 403 until migration is complete.
# -----------------------------------------------------------------------------
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# -----------------------------------------------------------------------------
# MANUS FORGE — leave empty. Legacy code paths are stubbed when these are unset.
# Only kept so older _core helpers (llm.ts, dataApi.ts, etc.) still compile.
# -----------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
